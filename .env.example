# =========================
# 应用基础配置
# =========================
APP_NAME=AI Life Simulator Backend
API_PREFIX=/api
ENVIRONMENT=development
APP_HOST=127.0.0.1
APP_PORT=8100

# 数据库路径：默认使用根目录 data/ 文件夹下的 sqlite 文件
DATABASE_URL=sqlite:///./data/life_simulator.db

# 业务配置文件位置
APP_CONFIG_PATH=config/app_config.toml
# 世界预设配置文件位置
WORLD_CONFIG_PATH=config/world_config.toml

# JWT 签名密钥：请替换为至少 32 字符的强随机值
SECRET_KEY=replace-with-a-strong-random-jwt-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 用户自定义 API Key 的加密密钥材料（用于服务端加密存储）
# 请替换为至少 32 字符的强随机值，且不要与 SECRET_KEY 重复
USER_DATA_ENCRYPTION_SECRET=replace-with-a-strong-random-data-encryption-secret

# 前端访问配置
# 开发环境前端访问地址（用于 CORS、启动脚本和文档展示；Vite 也会直接读取这里）
FRONTEND_DEV_ORIGIN=http://127.0.0.1:8101
# 生产环境前端对外地址（可留空）
FRONTEND_PUBLIC_ORIGIN=
# 允许跨域来源（可留空，程序会自动包含 FRONTEND_DEV_ORIGIN/FRONTEND_PUBLIC_ORIGIN）
ALLOWED_ORIGINS=

# 传输安全配置
# 生产建议开启：只允许 HTTPS 请求访问 API
ENFORCE_HTTPS=false
# 若部署在 Nginx/Traefik 等反向代理后，建议保持 true
TRUST_X_FORWARDED_PROTO=true
# 仅在可信反向代理会正确覆写 X-Forwarded-For 时再开启
TRUST_X_FORWARDED_FOR=false

# 登录安全防护
# 单个账号连续失败达到阈值后，会临时锁定
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_ACCOUNT_LOCK_MINUTES=15
# 单个 IP 在时间窗口内的最大登录尝试次数
LOGIN_MAX_ATTEMPTS_PER_IP_WINDOW=20
LOGIN_IP_WINDOW_SECONDS=300

# python main.py 时，是否同时拉起前端开发服务
START_FRONTEND_WITH_BACKEND=true
# 前端目录（相对项目根目录）
FRONTEND_DIR=frontend
# 前端启动命令（在 FRONTEND_DIR 内执行）
FRONTEND_DEV_COMMAND=npm run dev
# Vite 允许任意 Host 访问开发服务器；如需收紧可改为逗号分隔白名单
VITE_ALLOWED_HOSTS=*
# 前端开发代理默认指向本机后端，避免 APP_HOST=0.0.0.0 时代理到不可访问地址
VITE_API_PROXY_TARGET=http://127.0.0.1:8100
